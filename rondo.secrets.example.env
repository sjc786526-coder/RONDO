# Copy only the names needed by local profiles into the ignored repository-root
# `.env.local` file. Multiple paid_eval provider profiles may reuse one name;
# never put real credentials in this tracked example.
OPENAI_API_KEY=
OPENAI_OFFICIAL_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
RONDO_LOCAL_MODEL_API_KEY=

# Project-scoped RunPod S3 credentials. Keep real values only in the ignored
# repository-root `.env.local`; inject them only into the transfer subprocess.
RUNPOD_S3_ACCESS_KEY_ID=
RUNPOD_S3_SECRET_ACCESS_KEY=
