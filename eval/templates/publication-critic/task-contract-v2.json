{
  "schema": "rondo-publication-critic-task-contract-projection@v1",
  "authority": {
    "name": "rondo-publication-critic-task",
    "version": "v2",
    "path": "doc/rondo-multi-publication-critic-task-contract-v2.md"
  },
  "input": {
    "packet_schema": "rondo-publication-packet@v1",
    "qualification": "rondo-publication-qualification@v2",
    "input_contract": "eval/templates/publication-critic/input-contract-v3.md",
    "rubric": "eval/templates/publication-critic/qualification-rubric-v2.md",
    "render_contract": "eval/templates/publication-critic/render-contract-v4.json",
    "render_implementation": "eval/rondo_eval/publication_critic/render.py",
    "applicability_source": "model_visible_candidate_only",
    "forbidden_model_input_fields": [
      "completion_state",
      "public_state",
      "candidate_brief",
      "hidden_generation_intent",
      "split",
      "labels",
      "defects",
      "source",
      "generator",
      "reviewer",
      "pair_direction",
      "rationale"
    ]
  },
  "dimensions": {
    "order": [
      "useful_state_transfer",
      "honest_uncertainty",
      "conditional_continuity",
      "scope_and_signal",
      "internal_consistency"
    ],
    "classes": {
      "useful_state_transfer": ["PASS", "FAIL"],
      "honest_uncertainty": ["PASS", "FAIL"],
      "conditional_continuity": ["PASS", "FAIL", "N/A"],
      "scope_and_signal": ["PASS", "FAIL"],
      "internal_consistency": ["PASS", "FAIL"]
    }
  },
  "output": {
    "schema": "rondo-publication-critic-structured-output@v1",
    "backbone_forward_count": 1,
    "head_count": 5,
    "global_quality_head": null,
    "compatibility_scalar_is_derived": true,
    "decode_tie_policy": "fail_closed_to_FAIL_per_head"
  },
  "aggregation": {
    "discrete": "all_applicable_heads_pass",
    "pass": "PASS",
    "fail": "REWRITE",
    "quality": "min_applicable_pass_satisfaction",
    "compensation": "forbidden"
  },
  "loss": {
    "formula": "L_dim + lambda_gate L_gate + lambda_boundary L_boundary + lambda_inv L_invariance",
    "primary": "complete_per_dimension_absolute_classification",
    "gate": "derived_conjunction_only",
    "boundary": "finite_target_margin_plus_absolute_endpoint_gate_and_non_target_prediction_invariance",
    "invariance": "both_endpoints_pass_with_identical_hard_labels_and_gate",
    "soft_preference_in_qualification": false
  },
  "evaluation": {
    "primary": [
      "per_dimension_classification",
      "conditional_continuity_applicability",
      "gate_false_pass",
      "gate_false_rewrite",
      "boundary_absolute_closure",
      "soft_only_invariance"
    ],
    "legacy_scalar_metrics_are_diagnostic_only": true
  }
}
