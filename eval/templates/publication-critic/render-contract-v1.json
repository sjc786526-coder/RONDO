{
  "schema_version": 1,
  "name": "rondo-publication-critic-render",
  "revision": "v1",
  "messages": {
    "system": "absent",
    "count": 2,
    "user": {
      "order": [
        "qualification_rubric",
        "public_context"
      ],
      "public_context_fields": [
        "qualification",
        "actor_role",
        "target_kind",
        "local_scope",
        "continuity",
        "evidence_v1"
      ],
      "excluded_fields": [
        "candidate",
        "supervision"
      ]
    },
    "assistant": {
      "content": "complete_candidate",
      "fields": [
        "title",
        "summary",
        "handoff"
      ],
      "title_source": "local_scope.title"
    }
  },
  "chat_template": {
    "source": "frozen_tokenizer",
    "add_generation_prompt": false
  },
  "context": {
    "adopted_window_tokens": 16384,
    "mandatory": [
      "qualification_rubric",
      "complete_candidate"
    ],
    "candidate_truncation": "forbidden",
    "overflow": {
      "strategy": "drop_oldest_continuity_item",
      "unit": "whole_prior_publication",
      "rerender_and_retokenize_after_each_drop": true,
      "render_only_omission_field": "render_window_omitted_prior_publication_count",
      "render_only_omission_is_additional_to_packet_coverage": true,
      "mandatory_content_overflow": "typed_input_failure"
    }
  },
  "padding": {
    "binding": "scoring_identity",
    "semantic_parity_required": true
  }
}
