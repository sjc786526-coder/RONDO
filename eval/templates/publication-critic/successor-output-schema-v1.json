{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rondo-publication-critic-structured-output@v1",
  "x-rondo-runtime-validator": "eval/rondo_eval/publication_critic/successor_task.py#validate_structured_output",
  "x-rondo-runtime-decoder": "eval/rondo_eval/publication_critic/successor_task.py#decode_structured_output",
  "x-rondo-runtime-constraints": [
    "each head logits row count equals batch_size",
    "all logits are finite",
    "each head tie decodes fail-closed to FAIL"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "backbone_forward_count", "batch_size", "heads"],
  "properties": {
    "schema": {"const": "rondo-publication-critic-structured-output@v1"},
    "backbone_forward_count": {"const": 1},
    "batch_size": {"type": "integer", "minimum": 1},
    "heads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "useful_state_transfer",
        "honest_uncertainty",
        "conditional_continuity",
        "scope_and_signal",
        "internal_consistency"
      ],
      "properties": {
        "useful_state_transfer": {"$ref": "#/$defs/binary_head"},
        "honest_uncertainty": {"$ref": "#/$defs/binary_head"},
        "conditional_continuity": {"$ref": "#/$defs/continuity_head"},
        "scope_and_signal": {"$ref": "#/$defs/binary_head"},
        "internal_consistency": {"$ref": "#/$defs/binary_head"}
      }
    }
  },
  "$defs": {
    "finite_number": {"type": "number"},
    "binary_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "logits"],
      "properties": {
        "classes": {"const": ["PASS", "FAIL"]},
        "logits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"$ref": "#/$defs/finite_number"}
          }
        }
      }
    },
    "continuity_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "logits"],
      "properties": {
        "classes": {"const": ["PASS", "FAIL", "N/A"]},
        "logits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"$ref": "#/$defs/finite_number"}
          }
        }
      }
    }
  }
}
