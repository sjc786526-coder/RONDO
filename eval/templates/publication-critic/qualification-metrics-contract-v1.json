    "fail_to_pass",
    "fail_to_na",
    "pass_to_fail",
    "pass_to_na",
    "failure_recall"
  ],
  "zero_failure_denominator": {
    "status": "unavailable",
    "value": null
  },
  "gate_required": ["total", "correct", "false_pass", "false_rewrite"]
}
