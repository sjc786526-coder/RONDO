  "usage_envelope": {
    "max_input_tokens": 272000,
    "max_output_tokens": 128000,
    "basis": "Frozen upstream models.json pins gpt-5.6-terra at context_window=max_context_window=272000, so one request's prompt cannot exceed that. Output is bounded by the generic Usage contract's 128000, which is the tighter of the two limits and is already refused above. The generic contract also admits 1050000 input tokens, which is why a reservation sized for it is not an upper bound on a terra request."
  },
  "concurrency": {
    "max_concurrent_main_requests": 4,
    "guardian_reserved_slots": 1,
    "basis": "features.multi_agent_v2.max_concurrent_threads_per_session defaults to 4 in the frozen product, i.e. Root plus three simultaneously executing members. The budget proxy enforces the same number, so a fifth concurrent main is refused by the harness instead of silently costing money."
  },
  "runtime_lock_id": "multi-m5-runtime-v4",
  "provider_retry_backoff_seconds": "2",
  "unpriced_settlement": {
    "unpriced_stop_threshold": 1,
    "any_unpriced_invalidates_observation": true,
    "basis": "A settlement with no usage is charged its full reservation, so the batch stops after the first one. Independently of stopping, any tainted run is not evidence: gate 1 reads infra_failed and gate 2 sets counts_as_effective=false. The threshold decides whether the batch may continue; it never decides whether an observation counts."
  }
