  "activation_checkpointing": true,
  "attention_backend": "sdpa",
  "binary_micro_batch_size": 1,
  "gradient_clip_norm": 1.0,
  "macro_update": "one_full_v8_train_cohort",
  "objective": {
    "binary_loss": "softplus(-signed_target*logits[:,0])",
