    "epsilon": 1e-08,
    "fused": true,
    "learning_rate": 1e-05,
    "name": "torch.optim.AdamW",
    "weight_decay": 0.01
  },
  "pair_micro_batch_size": 1,
  "parameter_dtype": "float32",
  "scheduler": {
    "name": "constant"
