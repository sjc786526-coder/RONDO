{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {"type": "object"},
    "base": {"type": "object"},
    "bundle_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "cost": {"type": "object"},
    "dependencies": {"type": "object"},
    "hardware": {"type": "object"},
    "metrics": {"type": "object"},
    "output_paths": {"type": "object"},
    "provider": {"type": "object"},
    "persistence": {"type": "object"},
    "reload_receipt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "recipe_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "run_kind": {"enum": ["smoke", "formal"], "type": "string"},
    "schema_version": {"const": 1},
    "status": {"const": "completed"},
    "token_census": {"type": "object"},
    "train": {"type": "object"},
    "version": {"const": "rondo_local_approval_l6_training_receipt_v1"}
  },
  "required": [
    "schema_version",
    "version",
    "status",
    "base",
    "train",
    "token_census",
    "recipe_sha256",
    "run_kind",
    "dependencies",
    "cost",
    "provider",
    "persistence",
    "reload_receipt_sha256",
    "hardware",
    "metrics",
    "output_paths",
    "artifacts",
    "bundle_manifest_sha256"
  ],
  "title": "RONDO Local approval L6 training receipt v1",
  "type": "object"
}
