{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DurableSessionControlOperation": {
      "description": "Mutation requested from the current canonical Durable Session authority.",
      "oneOf": [
        {
          "properties": {
            "expected_producer_state": {
              "$ref": "#/definitions/DurableSessionTeamProducerState"
            },
            "expected_root_state": {
              "$ref": "#/definitions/DurableSessionTeamRootState"
            },
            "next_root_state": {
              "$ref": "#/definitions/DurableSessionTeamRootState"
            },
            "type": {
              "enum": [
                "setRootState"
              ],
              "title": "SetRootStateDurableSessionControlOperationType",
              "type": "string"
            },
            "version_id": {
              "type": "string"
            }
          },
          "required": [
            "expected_producer_state",
            "expected_root_state",
            "next_root_state",
            "type",
            "version_id"
          ],
          "title": "SetRootStateDurableSessionControlOperation",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "close"
              ],
              "title": "CloseDurableSessionControlOperationType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "CloseDurableSessionControlOperation",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "archive"
              ],
              "title": "ArchiveDurableSessionControlOperationType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "ArchiveDurableSessionControlOperation",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "unarchive"
              ],
              "title": "UnarchiveDurableSessionControlOperationType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "UnarchiveDurableSessionControlOperation",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "delete"
              ],
              "title": "DeleteDurableSessionControlOperationType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "DeleteDurableSessionControlOperation",
          "type": "object"
        }
      ]
    },
    "DurableSessionControlPrecondition": {
      "description": "Query proof that the server must revalidate before applying a control operation.\n\nA committed Team proof can authorize the operations exposed by its query projection. The delete-retry proof is deliberately narrower: it exists only after an earlier delete removed the Team snapshot but retained the canonical Root marker as the ThreadStore retry anchor.",
      "oneOf": [
        {
          "properties": {
            "commit_fingerprint": {
              "type": "string"
            },
            "commit_generation": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "expected_residency": {
              "$ref": "#/definitions/DurableSessionResidency"
            },
            "expected_storage_status": {
              "$ref": "#/definitions/DurableSessionStorageStatus"
            },
            "owner_incarnation": {
              "description": "Opaque identity of the observed loaded owner incarnation. Cold proofs carry `None`.",
              "type": [
                "string",
                "null"
              ]
            },
            "team_instance_id": {
              "type": "string"
            },
            "team_revision": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "type": {
              "enum": [
                "committedTeam"
              ],
              "title": "CommittedTeamDurableSessionControlPreconditionType",
              "type": "string"
            }
          },
          "required": [
            "commit_fingerprint",
            "commit_generation",
            "expected_residency",
            "expected_storage_status",
            "team_instance_id",
            "team_revision",
            "type"
          ],
          "title": "CommittedTeamDurableSessionControlPrecondition",
          "type": "object"
        },
        {
          "description": "Proof of a canonical cold Root marker whose committed Team snapshot is already absent. Only an explicit `Delete` attempt may consume this proof.",
          "properties": {
            "expected_residency": {
              "$ref": "#/definitions/DurableSessionResidency"
            },
            "expected_storage_status": {
              "$ref": "#/definitions/DurableSessionStorageStatus"
            },
            "root_marker_fingerprint": {
              "type": "string"
            },
            "type": {
              "enum": [
                "deleteRetryAnchor"
              ],
              "title": "DeleteRetryAnchorDurableSessionControlPreconditionType",
              "type": "string"
            }
          },
          "required": [
            "expected_residency",
            "expected_storage_status",
            "root_marker_fingerprint",
            "type"
          ],
          "title": "DeleteRetryAnchorDurableSessionControlPrecondition",
          "type": "object"
        }
      ]
    },
    "DurableSessionResidency": {
      "description": "Runtime residency observed only by the app-server answering this query.",
      "enum": [
        "observedOwnerHere",
        "ownerUnavailableHere",
        "notObservedHere",
        "unknown"
      ],
      "type": "string"
    },
    "DurableSessionStorageStatus": {
      "description": "Persistent source selected for this Session record.",
      "oneOf": [
        {
          "enum": [
            "active",
            "archived"
          ],
          "type": "string"
        },
        {
          "description": "The selected durable source could not prove active or archived status.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "DurableSessionTeamProducerState": {
      "enum": [
        "open",
        "closed"
      ],
      "type": "string"
    },
    "DurableSessionTeamRootState": {
      "enum": [
        "pending",
        "tracking",
        "resolved"
      ],
      "type": "string"
    }
  },
  "description": "Parameters for one authoritative Durable Session control attempt.",
  "properties": {
    "operation": {
      "$ref": "#/definitions/DurableSessionControlOperation"
    },
    "precondition": {
      "$ref": "#/definitions/DurableSessionControlPrecondition"
    },
    "rootThreadId": {
      "type": "string"
    },
    "sessionId": {
      "type": "string"
    }
  },
  "required": [
    "operation",
    "precondition",
    "rootThreadId",
    "sessionId"
  ],
  "title": "DurableSessionControlParams",
  "type": "object"
}