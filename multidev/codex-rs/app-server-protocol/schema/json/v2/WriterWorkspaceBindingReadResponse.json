        },
        "commonDir": {
          "$ref": "#/definitions/AbsolutePathBuf"
        },
        "environmentId": {
          "type": "string"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "gitDir": {
          "$ref": "#/definitions/AbsolutePathBuf"
        },
        "repositoryRoot": {
          "$ref": "#/definitions/AbsolutePathBuf"
        },
        "worktreeRoot": {
          "$ref": "#/definitions/AbsolutePathBuf"
        }
      },
      "required": [
        "availability",
        "commonDir",
        "environmentId",
        "generation",
        "gitDir",
        "repositoryRoot",
        "worktreeRoot"
      ],
      "type": "object"
    },
    "WriterWorkspaceBindingAvailability": {
      "oneOf": [
        {
          "properties": {
