# Local read-only checkout of the upstream Codex source.
/codex-source-code
reference-agent-harness/
/codex-doc/

# Personal Codex hooks, worktrees, and local state.
/.codex/
/.claude/

# Local test data and retained test-run artifacts.
/test-data/

# Evaluation recordings, evidence bundles, raw runs, and model weights.
/eval-data/

# Local RONDO credentials and machine-specific model runtime settings.
/.env.local
/rondo.local.toml

# Evaluation Python caches and project-local virtual environment.
/eval/**/__pycache__/
/eval/**/*.py[cod]
/eval/.venv/
/eval/results/*.lock
